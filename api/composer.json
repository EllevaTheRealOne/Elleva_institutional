{
  "name": "elleva/contact-api-v3",
  "type": "project",
  "description": "Elleva contact email API based on the existing Laravel API v3 architecture",
  "keywords": ["laravel", "elleva", "contact-api", "email"],
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.61.1"
  },
  "autoload": {
    "psr-4": {"App\\": "app/"}
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
